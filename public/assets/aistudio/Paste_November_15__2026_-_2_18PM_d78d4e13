<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Investment Platform | Inversión Inteligente con IA</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js para gráficos claros y accesibles -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 900: '#312e81' },
            safeGreen: '#10b981',
            warningYellow: '#f59e0b',
            dangerRed: '#ef4444'
          }
        }
      }
    }
  </script>
  <style>
    /* Estilos accesibles */
    :focus-visible {
      outline: 3px solid #4f46e5 !important;
      outline-offset: 2px !important;
    }
    .tooltip-content {
      display: none;
    }
    .tooltip-wrapper:hover .tooltip-content,
    .tooltip-wrapper:focus-within .tooltip-content {
      display: block;
    }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 flex flex-col font-sans transition-colors duration-200">

  <!-- ENCABEZADO Y BARRA DE NAVEGACIÓN ACCESIBLE -->
  <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-40 shadow-sm" role="banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-2xl shadow-md">
          📈
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
            Smart Invest <span class="text-xs bg-brand-100 text-brand-700 dark:bg-brand-900 dark:text-brand-300 font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">IA Cuantitativa</span>
          </h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Inversión transparente para todos los niveles</p>
        </div>
      </div>

      <!-- Controles de Accesibilidad & Modo Oscuro -->
      <div class="flex items-center space-x-3">
        <!-- Semáforo de Riesgo Visual en Header -->
        <div id="header-risk-pill" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs font-semibold" aria-live="polite">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Riesgo VaR: 1.6% (Seguro)</span>
        </div>

        <!-- Botón Modo Oscuro / Claro -->
        <button id="theme-toggle" class="p-3 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 transition" aria-label="Cambiar entre modo claro y oscuro">
          <span id="theme-icon">🌙</span>
        </button>

        <!-- Indicador de Broker / Paper -->
        <span class="text-xs bg-indigo-50 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 px-3 py-2 rounded-xl font-bold flex items-center gap-1.5">
          🛡️ Paper Trading Activo
        </span>
      </div>
    </div>

    <!-- Pestañas de Navegación -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-2 sm:space-x-8 overflow-x-auto py-2" role="navigation" aria-label="Secciones de la plataforma">
      <button onclick="switchTab('dashboard')" id="tab-dashboard" class="nav-tab active-tab text-brand-600 dark:text-brand-400 border-b-2 border-brand-600 font-bold px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        📊 Mi Portafolio
      </button>
      <button onclick="switchTab('market')" id="tab-market" class="nav-tab text-slate-600 dark:text-slate-400 hover:text-slate-900 border-b-2 border-transparent font-medium px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        🌐 Mi Mercado Hoy
      </button>
      <button onclick="switchTab('simulator')" id="tab-simulator" class="nav-tab text-slate-600 dark:text-slate-400 hover:text-slate-900 border-b-2 border-transparent font-medium px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        🔮 ¿Qué pasa con mi dinero?
      </button>
      <button onclick="switchTab('learn')" id="tab-learn" class="nav-tab text-slate-600 dark:text-slate-400 hover:text-slate-900 border-b-2 border-transparent font-medium px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        🎓 Aprende a Invertir (IA)
      </button>
      <button onclick="switchTab('options')" id="tab-options" class="nav-tab text-slate-600 dark:text-slate-400 hover:text-slate-900 border-b-2 border-transparent font-medium px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        📈 Opciones & Griegas
      </button>
      <button onclick="switchTab('backtest')" id="tab-backtest" class="nav-tab text-slate-600 dark:text-slate-400 hover:text-slate-900 border-b-2 border-transparent font-medium px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        🧪 Backtesting Cuantitativo
      </button>
      <button onclick="switchTab('profile')" id="tab-profile" class="nav-tab text-slate-600 dark:text-slate-400 hover:text-slate-900 border-b-2 border-transparent font-medium px-3 py-2 text-sm sm:text-base flex items-center gap-2">
        👤 Mi Perfil de Riesgo
      </button>
    </nav>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8" role="main">

    <!-- 1. VISTA DASHBOARD -->
    <section id="view-dashboard" class="space-y-8">
      
      <!-- Banner Informativo para Principiantes -->
      <div class="bg-indigo-600 text-white p-6 rounded-2xl shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold flex items-center gap-2">
            ¡Hola, Inversionista! 👋
          </h2>
          <p class="text-indigo-100 text-sm mt-1 max-w-2xl">
            Tu patrimonio está protegido mediante nuestro motor de riesgo cuantitativo 
            <strong>VaR 99%</strong> con un límite máximo estricto del <strong>2.5%</strong>.
            Cualquier duda, haz clic en los íconos <span class="bg-white/20 px-1.5 py-0.5 rounded text-xs font-bold">?</span> en pantalla.
          </p>
        </div>
        <button onclick="switchTab('simulator')" class="px-5 py-3 bg-white text-indigo-700 font-bold rounded-xl shadow-md hover:bg-indigo-50 transition text-sm">
          Simular escenarios de mi dinero ➡️
        </button>
      </div>

      <!-- Tarjetas de Capital & Rendimiento (12 Puntos Obligatorios) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- 1 & 3. Capital Total & Valor de Portafolio -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm relative">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Valor de tu Portafolio</span>
            <button onclick="openTooltip('accion')" class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center hover:bg-brand-500 hover:text-white transition" aria-label="Ver explicación de Portafolio">?</button>
          </div>
          <div class="mt-3 text-3xl font-black text-slate-900 dark:text-white" id="val-portfolio">$100,590.00 MXN</div>
          <div class="mt-2 text-xs text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
            ▲ +$590.00 MXN (+0.59%) hoy
          </div>
        </div>

        <!-- 2. Capital Disponible -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Dinero en Efectivo</span>
            <button onclick="openTooltip('comprar')" class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center hover:bg-brand-500 hover:text-white transition">?</button>
          </div>
          <div class="mt-3 text-3xl font-black text-slate-900 dark:text-white" id="val-cash">$60,000.00 MXN</div>
          <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 font-medium">Disponible para nuevas oportunidades</div>
        </div>

        <!-- 8. Riesgo Actual (VaR 99%) & Semáforo -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border-2 border-emerald-500/40 dark:border-emerald-500/30 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Riesgo Máximo (VaR 99%)</span>
            <button onclick="openTooltip('var')" class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center hover:bg-brand-500 hover:text-white transition">?</button>
          </div>
          <div class="mt-3 text-3xl font-black text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
            1.60% <span class="text-xs bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 px-2 py-0.5 rounded font-bold">SEGURO</span>
          </div>
          <div class="mt-2 text-xs text-slate-600 dark:text-slate-300 font-medium">
            Límite mandatorio: <strong>$2,500 MXN (2.5%)</strong>
          </div>
        </div>

        <!-- 10 & 11. Conexiones Broker & Bot -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estado de Conexión</span>
            <button onclick="openTooltip('diversificar')" class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center hover:bg-brand-500 hover:text-white transition">?</button>
          </div>
          <div class="mt-3 space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-200">
              <span>Interactive Brokers:</span>
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">🟢 Paper OK</span>
            </div>
            <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-200">
              <span>Gate.io Testnet:</span>
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">🟢 Activo</span>
            </div>
            <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-200">
              <span>IA Random Forest:</span>
              <span class="text-indigo-600 dark:text-indigo-400 flex items-center gap-1">⚡ Listo</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Gráfico de Rendimiento Fácil de Interpretar -->
      <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
          <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              Evolución de tu Dinero y Protección de Riesgo
              <button onclick="openTooltip('volatilidad')" class="w-5 h-5 rounded-full bg-slate-200 dark:bg-slate-700 text-xs flex items-center justify-center">?</button>
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Visualiza tu capital frente a la banda de riesgo protegido (VaR 2.5%)</p>
          </div>
          <span class="text-xs bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold px-3 py-1.5 rounded-lg">Últimos 30 días</span>
        </div>
        <div class="h-64 sm:h-80 w-full">
          <canvas id="portfolioChart"></canvas>
        </div>
      </div>

      <!-- Operaciones Abiertas y Protegidas -->
      <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          Inversiones Abiertas en este Momento (Operaciones)
          <button onclick="openTooltip('stop_loss')" class="w-5 h-5 rounded-full bg-slate-200 dark:bg-slate-700 text-xs flex items-center justify-center">?</button>
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm" role="table" aria-label="Tabla de operaciones abiertas">
            <thead class="bg-slate-50 dark:bg-slate-900/50 text-xs uppercase text-slate-500 font-bold border-b border-slate-200 dark:border-slate-700">
              <tr>
                <th class="p-3">Activo</th>
                <th class="p-3">Tipo</th>
                <th class="p-3">Invertido</th>
                <th class="p-3">Precio Entrada</th>
                <th class="p-3">Precio Actual</th>
                <th class="p-3">Cinturón (Stop Loss)</th>
                <th class="p-3">Meta (Take Profit)</th>
                <th class="p-3">Ganancia / Pérdida</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition">
                <td class="p-3 font-bold text-slate-900 dark:text-white flex items-center gap-2">
                  <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs">SPY</span>
                  S&P 500 ETF
                </td>
                <td class="p-3"><span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">COMPRA (LONG)</span></td>
                <td class="p-3 font-semibold">$25,510.00</td>
                <td class="p-3">$510.20</td>
                <td class="p-3 font-bold">$514.80</td>
                <td class="p-3 text-red-500 font-semibold">$500.00</td>
                <td class="p-3 text-emerald-500 font-semibold">$530.00</td>
                <td class="p-3 text-emerald-600 dark:text-emerald-400 font-extrabold">+$230.00 (+0.90%)</td>
              </tr>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition">
                <td class="p-3 font-bold text-slate-900 dark:text-white flex items-center gap-2">
                  <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-800 flex items-center justify-center font-bold text-xs">AAPL</span>
                  Apple Inc.
                </td>
                <td class="p-3"><span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">COMPRA (LONG)</span></td>
                <td class="p-3 font-semibold">$22,050.00</td>
                <td class="p-3">$220.50</td>
                <td class="p-3 font-bold">$224.10</td>
                <td class="p-3 text-red-500 font-semibold">$215.00</td>
                <td class="p-3 text-emerald-500 font-semibold">$235.00</td>
                <td class="p-3 text-emerald-600 dark:text-emerald-400 font-extrabold">+$360.00 (+1.63%)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </section>

    <!-- 2. VISTA MI MERCADO HOY -->
    <section id="view-market" class="hidden space-y-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white">🌐 Mi Mercado Hoy</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Resumen claro de oportunidades, tendencias y sentimiento del mercado.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Oportunidades del Bot -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm md:col-span-2">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
            ⭐ Oportunidades Identificadas por la IA
          </h3>
          <div class="space-y-4">
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-base text-slate-900 dark:text-white">SPY (S&P 500 ETF)</span>
                  <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800">Señal BUY</span>
                  <span class="px-2 py-0.5 rounded text-xs font-bold bg-indigo-100 text-indigo-800">Score Gemini: 84/100</span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                  Alta probabilidad de rebote técnico confirmada por Random Forest y cruce de EMA 20/50.
                </p>
              </div>
              <button onclick="requestAssetExplanation('SPY')" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl text-xs transition">
                💡 Explícame esta inversión
              </button>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-base text-slate-900 dark:text-white">XRP / USDT (Cripto)</span>
                  <span class="px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800">Señal BUY</span>
                  <span class="px-2 py-0.5 rounded text-xs font-bold bg-indigo-100 text-indigo-800">Score Gemini: 78/100</span>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                  RSI en zona de sobreventa (32) con soporte firme y volumen acumulativo en velas de 2 min.
                </p>
              </div>
              <button onclick="requestAssetExplanation('XRP_USDT')" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl text-xs transition">
                💡 Explícame esta inversión
              </button>
            </div>
          </div>
        </div>

        <!-- Sentimiento en Redes (X / Twitter) -->
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2">
            🐦 Percepción Social en X
          </h3>
          <p class="text-xs text-slate-500 mb-4">Filtrado contra spam, bots y publicaciones duplicadas.</p>
          <div class="text-center p-4 bg-slate-50 dark:bg-slate-900/60 rounded-xl mb-4">
            <div class="text-3xl font-black text-emerald-600 dark:text-emerald-400">64.3% Alcista</div>
            <div class="text-xs font-bold text-slate-500 mt-1">Consenso: BULLISH (Confianza: 82.5%)</div>
          </div>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between text-slate-600 dark:text-slate-300">
              <span>Muestras analizadas:</span>
              <span class="font-bold">42 publicaciones</span>
            </div>
            <div class="flex justify-between text-slate-600 dark:text-slate-300">
              <span>Sentimiento Bajista:</span>
              <span class="font-bold text-red-500">19.0%</span>
            </div>
            <div class="flex justify-between text-slate-600 dark:text-slate-300">
              <span>Sentimiento Neutral:</span>
              <span class="font-bold text-slate-500">16.7%</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. VISTA SIMULADOR: ¿QUÉ PUEDE PASAR CON MI DINERO? -->
    <section id="view-simulator" class="hidden space-y-8">
      <div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white">🔮 Simulador: ¿Qué puede pasar con mi dinero?</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Ingresa una cantidad y conoce los posibles escenarios positivos, normales y de estrés.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 dark:text-slate-300 mb-1" for="sim-amount">Cantidad a Invertir (MXN)</label>
            <input type="number" id="sim-amount" value="100000" class="w-full p-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-lg font-bold">
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 dark:text-slate-300 mb-1" for="sim-days">Horizonte (Días)</label>
            <select id="sim-days" class="w-full p-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-sm font-semibold">
              <option value="30">30 días (1 mes)</option>
              <option value="90">90 días (3 meses)</option>
              <option value="180">180 días (6 meses)</option>
              <option value="365">365 días (1 año)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 dark:text-slate-300 mb-1" for="sim-profile">Perfil de Inversión</label>
            <select id="sim-profile" class="w-full p-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-sm font-semibold">
              <option value="conservador">Conservador (Baja volatilidad)</option>
              <option value="moderado" selected>Moderado (Equilibrado)</option>
              <option value="agresivo">Agresivo (Mayor crecimiento)</option>
            </select>
