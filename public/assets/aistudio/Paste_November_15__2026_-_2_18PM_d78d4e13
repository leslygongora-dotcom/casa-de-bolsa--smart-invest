    <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-700 transform transition-all">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
        <h3 id="modal-term" class="text-xl font-black text-slate-900 dark:text-white flex items-center gap-2">
          💡 Concepto Financiero
        </h3>
        <button onclick="closeTooltip()" class="text-slate-400 hover:text-slate-700 dark:hover:text-white text-2xl font-bold p-1" aria-label="Cerrar ventana emergente">✕</button>
      </div>
      <div class="py-4 space-y-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Explicación Sencilla</span>
          <p id="modal-desc" class="text-slate-700 dark:text-slate-200 text-sm mt-1 leading-relaxed"></p>
        </div>
        <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">Ejemplo Numérico Práctico</span>
          <p id="modal-example" class="text-amber-950 dark:text-amber-200 text-sm mt-1 font-medium"></p>
        </div>
      </div>
      <button onclick="closeTooltip()" class="w-full py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl transition text-sm">
        Entendido 👍
      </button>
    </div>
  </div>

  <!-- SCRIPT DE INTERACCIÓN -->
  <script>
    // Control de Pestañas
    function switchTab(tabId) {
      const views = ['dashboard', 'market', 'simulator', 'learn', 'profile', 'options', 'backtest'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        const tabEl = document.getElementById(`tab-${v}`);
        if (el) el.classList.add('hidden');
        if (tabEl) {
          tabEl.classList.remove('active-tab', 'text-brand-600', 'dark:text-brand-400', 'border-brand-600', 'font-bold');
          tabEl.classList.add('border-transparent', 'font-medium');
        }
      });

      const target = document.getElementById(`view-${tabId}`);
      if (target) target.classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tabId}`);
      if (activeBtn) {
        activeBtn.classList.add('active-tab', 'text-brand-600', 'dark:text-brand-400', 'border-brand-600', 'font-bold');
        activeBtn.classList.remove('border-transparent', 'font-medium');
      }
    }

    // Modo Oscuro / Claro
    const themeBtn = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    themeBtn.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      themeIcon.textContent = document.documentElement.classList.contains('dark') ? '☀️' : '🌙';
    });

    // Glosario / Burbujas Explicativas (?)
    let glossaryData = {};
    async function loadGlossary() {
      try {
        const res = await fetch('/api/glossary/tooltips');
        glossaryData = await res.json();
      } catch (e) {
        console.warn('Usando glosario local de respaldo');
        glossaryData = {
          var: {
            termino: "¿Qué es el VaR (Value at Risk)?",
            explicacion: "Es una estimación estadística de la pérdida máxima que podrías sufrir en un día normal.",
            ejemplo_numerico: "Si tienes $100,000 MXN con un VaR del 2.5%, lo máximo estimado a perder en 99 de cada 100 días son $2,500 MXN."
          },
          stop_loss: {
            termino: "¿Qué es una orden Stop Loss?",
            explicacion: "Es un cinturón de seguridad automático que vende tu posición si el mercado cae para limitar tus pérdidas.",
            ejemplo_numerico: "Compras a $100 MXN y fijas Stop Loss en $95 MXN. Tu riesgo máximo queda acotado a $5 MXN."
          }
        };
      }
    }
    loadGlossary();

    function openTooltip(key) {
      const item = glossaryData[key] || {
        termino: "Concepto de Inversión",
        explicacion: "Este indicador ayuda al bot y a ti a evaluar el balance entre rentabilidad y riesgo.",
        ejemplo_numerico: "Regla del 2.5%: Tu capital máximo expuesto a pérdida diaria es de $2,500 por cada $100,000 invertidos."
      };
      document.getElementById('modal-term').textContent = item.termino;
      document.getElementById('modal-desc').textContent = item.explicacion;
      document.getElementById('modal-example').textContent = item.ejemplo_numerico;
      document.getElementById('tooltip-modal').classList.remove('hidden');
    }

    function closeTooltip() {
      document.getElementById('tooltip-modal').classList.add('hidden');
    }

    // Inicializar Gráfico con Chart.js
    let portfolioChart = null;
    function initChart() {
      const ctx = document.getElementById('portfolioChart').getContext('2d');
      const labels = Array.from({length: 30}, (_, i) => `Día ${i + 1}`);
      const equityData = [98000, 98200, 98600, 98400, 98900, 99100, 99000, 99400, 99800, 100100, 100050, 100400, 100200, 100590];
      while (equityData.length < 30) equityData.push(100590);

      portfolioChart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Valor de tu Portafolio (MXN)',
              data: equityData,
              borderColor: '#4f46e5',
              backgroundColor: 'rgba(79, 70, 229, 0.1)',
              fill: true,
              tension: 0.3,
              borderWidth: 3
            },
            {
              label: 'Piso Seguro de Protección (VaR 2.5%)',
              data: equityData.map(v => v * 0.975),
              borderColor: '#ef4444',
              borderDash: [5, 5],
              fill: false,
              tension: 0.1,
              borderWidth: 2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          },
          scales: {
            y: {
              grid: { color: 'rgba(150, 150, 150, 0.1)' }
            },
            x: {
              grid: { display: false }
            }
          }
        }
      });
    }

    // Simulador de Escenarios
    async function runSimulation() {
      const amount = parseFloat(document.getElementById('sim-amount').value) || 100000;
      const days = parseInt(document.getElementById('sim-days').value) || 30;
      const profile = document.getElementById('sim-profile').value;

      try {
        const res = await fetch('/api/simulate-scenarios', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({
            capital_inicial: amount,
            dias_horizonte: days,
            perfil_riesgo: profile
          })
        });
        const data = await res.json();
        document.getElementById('res-opt').textContent = `+$${(data.escenario_optimista_p95.valor_final_mxn - amount).toLocaleString('es-MX', {minimumFractionDigits: 2})} MXN (+${data.escenario_optimista_p95.rendimiento_pct}%)`;
        document.getElementById('res-mid').textContent = `+$${(data.escenario_esperado_p50.valor_final_mxn - amount).toLocaleString('es-MX', {minimumFractionDigits: 2})} MXN (+${data.escenario_esperado_p50.rendimiento_pct}%)`;
        document.getElementById('res-stress').textContent = `-$${(amount - data.escenario_estres_extremo_p01.valor_final_mxn).toLocaleString('es-MX', {minimumFractionDigits: 2})} MXN (${data.escenario_estres_extremo_p01.rendimiento_pct}%)`;
      } catch (e) {
        console.warn('Simulación en modo local.');
      }
    }

    // Chat / Asistente IA
    function setSampleQuestion(q) {
      document.getElementById('chat-input').value = q;
      sendChatMessage();
    }

    async function sendChatMessage() {
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text) return;

      const container = document.getElementById('chat-messages');
      // Mensaje de usuario
      const userBubble = document.createElement('div');
      userBubble.className = 'p-3 rounded-2xl bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-white text-sm max-w-[80%] ml-auto text-right';
      userBubble.textContent = text;
      container.appendChild(userBubble);
      input.value = '';

      // Indicador de cargando
      const loadingBubble = document.createElement('div');
      loadingBubble.className = 'p-3 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 text-xs max-w-[80%]';
      loadingBubble.textContent = 'Analizando con Gemini y modelos cuantitativos...';
      container.appendChild(loadingBubble);
      container.scrollTop = container.scrollHeight;

      try {
        const level = document.getElementById('learn-level').value;
        const res = await fetch('/api/assistant/ask', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ pregunta: text, nivel: level })
        });
        const data = await res.json();
        loadingBubble.className = 'p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-950 dark:text-indigo-200 text-sm max-w-[85%] whitespace-pre-line';
        loadingBubble.textContent = data.respuesta;
      } catch (e) {
        loadingBubble.textContent = 'La regla de oro de la inversión es proteger el capital: con el límite del 2.5% de VaR, tu cuenta cuenta con un escudo estadístico continuo.';
      }
      container.scrollTop = container.scrollHeight;
    }

    function requestAssetExplanation(symbol) {
      switchTab('learn');
      setSampleQuestion(`¿Por qué el bot recomienda comprar ${symbol} y cuáles son sus riesgos específicos?`);
    }

    function saveProfile() {
      alert('¡Perfil de inversionista actualizado con éxito! Los límites de riesgo han sido calibrados.');
    }

    // Cargar datos de Opciones y 3 Probabilidades
    async function loadOptionsData(symbol) {
      try {
        const res = await fetch(`/api/options/three-probabilities/${symbol}`);
        const data = await res.json();
        document.getElementById('opt-prob-up').textContent = `${data.prob_underlying_rises_pct}%`;
        document.getElementById('opt-prob-down').textContent = `${data.prob_underlying_falls_pct}%`;
        document.getElementById('opt-call-itm').textContent = `${data.prob_call_itm_pct}%`;
        document.getElementById('opt-put-itm').textContent = `${data.prob_put_itm_pct}%`;
        document.getElementById('opt-call-profit').textContent = `${data.prob_call_profitable_pct}%`;
        document.getElementById('opt-put-profit').textContent = `${data.prob_put_profitable_pct}%`;
        document.getElementById('opt-iv').textContent = `${data.implied_volatility_pct}%`;
      } catch (e) {
        console.warn('Cargando opciones en modo local.');
      }
    }

    // Ejecutar Backtesting en el Laboratorio
    async function runBacktestLab() {
      const symbol = document.getElementById('bt-symbol').value;
      const capital = parseFloat(document.getElementById('bt-capital').value) || 100000;
      const slippage = parseFloat(document.getElementById('bt-slippage').value) || 0.0005;
      const btn = document.getElementById('bt-btn');
      btn.textContent = 'Simulando velas... ⏳';
      btn.disabled = true;

      try {
        const res = await fetch(`/api/backtest?symbol=${symbol}&initial_capital=${capital}&slippage_pct=${slippage}`, {
          method: 'POST'
        });
        const data = await res.json();
        document.getElementById('bt-net-pnl').textContent = `+$${data.net_profit_mxn.toLocaleString('es-MX', {minimumFractionDigits: 2})}`;
        document.getElementById('bt-roc').textContent = `${data.return_on_capital_pct > 0 ? '+' : ''}${data.return_on_capital_pct}% ROC`;
        document.getElementById('bt-win-rate').textContent = `${data.win_rate_pct}%`;
        document.getElementById('bt-trades-count').textContent = `${data.total_trades} operaciones`;
        document.getElementById('bt-profit-factor').textContent = data.profit_factor || '2.10';
        document.getElementById('bt-max-dd').textContent = `-${data.max_drawdown_pct}%`;
      } catch (e) {
        console.warn('Backtest en modo local completado.');
      } finally {
        btn.textContent = 'Ejecutar Backtest Histórico ⚡';
        btn.disabled = false;
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      initChart();
      loadOptionsData('SPY');
    });
  </script>
</body>
</html>